// ABRIGO STEVENSON — SEM INSCRIÇÕES, PASSAGEM DE CABOS DE 20 mm
// Unidades: milímetros. Arquivo independente: não precisa dos STL originais.
// Geometria original incorporada como polyhedron() ao final deste arquivo.
// Origem local: Stevenson screen for wireless meteorological sensor - 83969.
// A inscrição original identificava Bart Gallet / USA; crédito mantido
// somente neste comentário, sem texto nas peças.

/* [Visualização / exportação] */
// Escolha uma peça para exportar seu STL (F6, depois F7 no OpenSCAD).
peca = "todas"; // [todas:Todas lado a lado, inferior:Inferior, intermediaria:Intermediária, superior:Superior]

/* [Passagem de cabos] */
// Diâmetro livre mínimo do furo central da peça inferior (original: 5 mm).
diametro_cabos = 20; // [5:0.5:38]

/* [Hidden] */

// Os encaixes, furos de fixação, bordas e alturas vêm da malha original.
// A tampa superior continua fechada; só a passagem existente na base muda.
// Cada peça permanece na orientação do STL original, com Z mínimo = 0.

module stevenson_inferior(diametro = 20) {
    assert(diametro >= 5 && diametro <= 38,
           "Use diâmetro entre 5 e 38 mm para preservar o tubo central.");
    difference() {
        _original_inferior();

        // Furo coaxial ao tubo. O tubo tem Ø externo 42 e interno 40 mm.
        // A correção pelo cosseno garante o diâmetro livre entre facetas.
        translate([0, 0, -1])
            cylinder(h = 54, d = diametro / cos(180 / 160), $fn = 160);

        // As letras originais ocupam X=-19,702..20,816,
        // Y=-49,579..-32,534 e Z=1,4..3,4 mm.
        // Corte somente do relevo, nivelado com a face superior da base.
        translate([-21, -51, 1.4])
            cube([43, 20, 2.5]);
    }
}

module stevenson_intermediaria() {
    _original_intermediaria();
}

module stevenson_superior() {
    _original_superior();
}

module stevenson(peca = "todas", diametro = 20) {
    assert(peca == "todas" || peca == "inferior"
           || peca == "intermediaria" || peca == "superior",
           "Peça inválida: use todas, inferior, intermediaria ou superior.");
    if (peca == "todas") {
        translate([-160, 0, 0]) stevenson_inferior(diametro);
        stevenson_intermediaria();
        translate([160, 0, 0]) stevenson_superior();
    } else if (peca == "inferior") {
        stevenson_inferior(diametro);
    } else if (peca == "intermediaria") {
        stevenson_intermediaria();
    } else if (peca == "superior") {
        stevenson_superior();
    }
}

stevenson(peca, diametro_cabos);

